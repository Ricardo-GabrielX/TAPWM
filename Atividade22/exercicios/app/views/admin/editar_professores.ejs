<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Professor - Fatec Sorocaba</title>
</head>
<body>
    <h1>Editar Professor</h1>
    <p>ID: <%= professor.ID_PROFESSOR %></p>
    <% if (erro) { %><p role="alert"><%= erro %></p><% } %>
    <form action="/professor/editar" method="post">
        <input type="hidden" name="id_professor" value="<%= professor.ID_PROFESSOR %>">
        <label for="nome">Nome:</label>
        <input type="text" id="nome" name="nome_professor" maxlength="50" value="<%= professor.NOME_PROFESSOR %>" required><br><br>
        <label for="email">E-mail:</label>
        <input type="email" id="email" name="email_professor" maxlength="100" value="<%= professor.EMAIL_PROFESSOR %>" required><br><br>
        <button type="submit">Salvar alterações</button>
    </form>
    <p><a href="/admin/crud_professores">Voltar para a lista</a></p>
</body>
</html>
